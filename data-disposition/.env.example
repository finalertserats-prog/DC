# Google OAuth (standalone web app auth)
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
# Strong random secret for signing JWTs (use: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=""

# Teams Bot Framework (no longer used – kept for reference)
# MICROSOFT_BOT_ID=""
# MICROSOFT_BOT_PASSWORD=""
# MICROSOFT_APP_TENANT_ID=""

# LLM provider
LLM_BASE_URL="https://llm.techsophy.com/"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_PROVIDER="openai-compatible"
LLM_TIMEOUT_SECS="60"
LLM_MAX_OUTPUT_TOKENS="2000"
TARGET_LATENCY_MS="3500"

# MCP servers (multi-server)
MCP_SERVERS="codeiq=http://localhost:8081/mcp_codeiq;task_management=http://localhost:8080/mcp_task_management;open_project=http://localhost:8009/mcp_open_project"

# Legacy single server fallback (optional)
MCP_URL="http://localhost:8081/mcp_codeiq"
MCP_TOOLS_CACHE_SECS="60"

# Read-only overrides (optional)
MCP_READONLY_ALLOWLIST="codeiq=http://localhost:8081/mcp_codeiq;task_management=http://localhost:8080/mcp_task_management;open_project=http://localhost:8009/mcp_open_project"

# Planner/runtime limits
PLAN_MAX_STEPS="4"
PLAN_MAX_CONCURRENCY="2"
TOOL_TIMEOUT_SECS="30"
RETRY_ON_TOOL_ERROR="1"

# Redis/history
REDIS_URL=""
HISTORY_MAX_TURNS="30"
HISTORY_MAX_TOKENS="8000"
HISTORY_TTL_SECS="604800"
SINGLE_USER_ID="default"

# HTTP server
TEAMS_GATEWAY_HOST=""
TEAMS_GATEWAY_PORT=""

# MCP result cache
MCP_RESULT_CACHE_SECS="30"
MCP_RESULT_CACHE_MAX_BYTES="1000000"
ATTACH_MAX_INLINE_BYTES="900000"
ATTACH_DATA_URLS=true
